{
  "name": "aileron",
  "version": "1.0.0-beta.01",
  "description": "backend server for azure marketing site",
  "license": "ISC",
  "author": "Maher Abaza",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@scalar/fastify-api-reference": "^1.52.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "typebox": "^1.0.70"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"require('fs').cpSync('src/assets', 'dist/assets', {recursive: true})\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint --ext .ts,.tsx,.js,.jsx --fix .",
    "lint:ci": "eslint --ext .ts,.tsx,.js,.jsx . --max-warnings=0",
    "format": "prettier --write .",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  }
}